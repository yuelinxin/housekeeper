# Generated by build-aux/arch_package.py for the adjacent source archive.
pkgname=housekeeper
pkgver=@VERSION@
pkgrel=1
pkgdesc='Discover and manage installed desktop applications'
arch=('any')
url='https://github.com/yuelinxin/housekeeper'
license=('MIT' 'CC0-1.0' 'LGPL-3.0-only')
depends=(
  'python>=3.10'
  'python-gobject'
  'gtk4>=1:4.12'
  'libadwaita>=1:1.4'
  'librsvg'
  'adwaita-icon-theme'
  'pacman'
)
makedepends=('meson' 'glib2-devel')
checkdepends=('python-pytest' 'desktop-file-utils' 'appstream')
optdepends=(
  'packagekit: search native packages and manage software sources'
  'flatpak: manage Flatpak applications'
  'appstream: native application search metadata support'
  'archlinux-appstream-data: native application search metadata'
  'squashfs-tools: read AppImage launcher metadata'
)
options=('!debug')
source=("${pkgname}-${pkgver}-arch.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
  arch-meson "${pkgname}-${pkgver}" build -Dpackage_format=none
  meson compile -C build
}

check() {
  meson test -C build --print-errorlogs
  desktop-file-validate build/data/io.github.yuelinxin.housekeeper.desktop
  appstreamcli validate --no-net "${pkgname}-${pkgver}/data/io.github.yuelinxin.housekeeper.metainfo.xml"
}

package() {
  DESTDIR="$pkgdir" meson install -C build --no-rebuild
  # Ship bytecode so pacman owns it; Python would otherwise write unowned caches.
  python -m compileall -q -o 0 -o 1 -s "$pkgdir" -p / "$pkgdir/usr/share/housekeeper"
  install -Dm644 "${pkgname}-${pkgver}/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
