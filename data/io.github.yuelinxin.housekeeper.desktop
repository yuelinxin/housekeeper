[Desktop Entry]
Name=Housekeeper
Comment=Find where your applications come from and manage them
Exec=housekeeper %F
Icon=io.github.yuelinxin.housekeeper
Terminal=false
Type=Application
Categories=GTK;System;PackageManager;
Keywords=apps;applications;uninstall;packages;flatpak;appimage;pwa;
StartupNotify=true
MimeType=application/vnd.appimage;application/x-iso9660-appimage;application/x-rpm;application/vnd.debian.binary-package;application/vnd.flatpak;application/vnd.flatpak.ref;application/vnd.flatpak.repo;
